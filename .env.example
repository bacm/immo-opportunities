# Copy to .env for local development. Do not put secrets in this file.
COMPOSE_PROJECT_NAME=immo-opportunities
TZ=Europe/Paris
SITE_ADDRESS=http://localhost:8080
APP_DOMAIN=localhost
POSTGRES_DATA_PATH=./.runtime/postgres
MINIO_DATA_PATH=./.runtime/minio
RUNTIME_DATA_PATH=./.runtime
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
KEYCLOAK_HOST_PORT=18081
KEYCLOAK_MANAGEMENT_HOST_PORT=19002
CADDY_HOST_PORT=8080
GRAFANA_HOST_PORT=3000
API_HOST_PORT=18000
MARTIN_HOST_PORT=13000
DAGSTER_HOST_PORT=13001
API_DOCS_ENABLED=true
ENVIRONMENT=development
OIDC_ENABLED=true

# Images are pinned to explicit releases. Production must additionally pin digests.
# Reglage PostgreSQL. Les valeurs par defaut de compose.yaml visent un hote de 16 Go et
# conviennent au poste de developpement ; sur un VPS plus petit, reduire shared_buffers a
# 25 % de la RAM et effective_cache_size a 75 %. Voir docs/operations/postgresql-tuning.md.
# POSTGRES_SHARED_BUFFERS=2GB
# POSTGRES_EFFECTIVE_CACHE_SIZE=8GB
# POSTGRES_WORK_MEM=64MB
# POSTGRES_MAINTENANCE_WORK_MEM=1GB
POSTGRES_IMAGE=postgis/postgis:15-3.5
POSTGRES_PLATFORM=linux/amd64
REDIS_IMAGE=redis:8.2.6-alpine
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-06-13T11-33-47Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-05-21T01-59-54Z
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.0
CADDY_IMAGE=caddy:2.11.4-alpine
MARTIN_IMAGE=ghcr.io/maplibre/martin:1.13.0
API_IMAGE=immo-opportunities-api:local
PIPELINES_IMAGE=immo-opportunities-pipelines:local
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
LOKI_IMAGE=grafana/loki:3.7.2
GRAFANA_IMAGE=grafana/grafana:13.1.0
ALLOY_IMAGE=grafana/alloy:v1.18.0
BUSYBOX_IMAGE=busybox:1.37.0
