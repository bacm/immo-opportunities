{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "DS-15",
  "contract_version": 1,
  "name": "Base permanente des équipements",
  "producer": "INSEE",
  "homepage": "https://www.insee.fr/fr/metadonnees/source/serie/s1161",
  "licence": {
    "name": "Licence Ouverte 2.0",
    "spdx_like_id": "etalab-2.0",
    "url": "https://www.etalab.gouv.fr/licence-ouverte-open-licence/",
    "commercial_reuse": true,
    "derivatives_allowed": true,
    "personal_data": false,
    "attribution": "Insee, base permanente des équipements"
  },
  "release": {
    "key_format": "bpe-YYYY",
    "discovery_url": "https://api.insee.fr/melodi/catalog/all",
    "preferred_format": "Melodi CSV distribution (zip), archived before import",
    "partition_dimensions": [
      "release",
      "department"
    ],
    "checksum_algorithm": "sha256",
    "latest_alias_forbidden_for_reproducible_imports": true,
    "access_note": "Fichier national de l'INSEE ; l'URL n'est pas datée ou peut être republiée : la copie archivée nommée au manifeste fait foi, contrainte par son SHA-256 (SPEC §13.9)."
  },
  "coverage": {
    "country": "FR",
    "initial_departments": [
      "35"
    ],
    "granularity": "commune",
    "geography_vintage": 2025
  },
  "layers": {
    "equipments": {
      "target": "observation.territorial_indicator",
      "melodi_dataset": "DS_BPE",
      "required_columns": [
        "GEO",
        "GEO_OBJECT",
        "FACILITY_DOM",
        "FACILITY_SDOM",
        "FACILITY_TYPE",
        "BPE_MEASURE",
        "TIME_PERIOD",
        "OBS_VALUE"
      ],
      "indicators": {
        "equipements_total": "FACILITY_DOM=_T",
        "equipements_domaine_<d>": "FACILITY_SDOM=_T",
        "equipements_sous_domaine_<sd>": "FACILITY_TYPE=_T"
      },
      "unit": "équipements"
    }
  },
  "decision": "docs/decisions/ADR-023-sources-territoriales.md",
  "field_policy": {
    "missing_value": "commune absente de la source : source_value_missing, jamais zéro",
    "parcel_join": "administrative only; a commune value is never a parcel measurement"
  },
  "zero_policy": "La BPE est un dénombrement : une commune citée par la BPE sans ligne pour un sous-domaine en compte zéro ; une commune absente de la BPE reste absente.",
  "quality_checks": [
    {
      "code": "checksum",
      "version": "1",
      "scope": "asset",
      "blocks_publication": true
    },
    {
      "code": "schema",
      "version": "1",
      "scope": "asset",
      "blocks_publication": true
    },
    {
      "code": "commune_coverage",
      "version": "1",
      "scope": "commune",
      "blocks_publication": false
    }
  ],
  "publication": {
    "atomic_pointer_scope": "release_department",
    "acceptance_report_required": true,
    "product_role": "plateforme, segmentation (E6) ; hors baromètre et radar"
  },
  "retention": {
    "raw_assets": "permanent and immutable",
    "observations": "append-only by release"
  }
}
