    {"feature":"MKT-104","component":"market_liquidity","weight":0.25,"requirement":"confidence_only","transformation":"local_percentile","direction":"confidence_only","template":"La récence médiane des comparables est {value}."},
    {"feature":"MKT-105","component":"market_liquidity","weight":0.10,"requirement":"optional","transformation":"local_percentile","direction":"increasing","template":"La tendance locale se situe au percentile {comparison}."},

