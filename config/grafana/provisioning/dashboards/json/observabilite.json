  "schemaVersion": 41,
  "tags": [
    "observabilite",
    "g7"
  ],
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "request_id",
        "label": "Référence (X-Request-ID)",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Immo — observabilité",
  "uid": "immo-observabilite",
  "version": 1,
  "panels": [
    {
      "type": "row",
      "title": "1. L'application est-elle lente ? Latence API par route",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "p95 par route (ms, fenêtre 5 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(immo_api_request_duration_milliseconds_bucket{route!~\"/health/.*\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ],
      "id": 2
    },
    {
      "type": "table",
      "title": "Par route, depuis le démarrage d'Alloy",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p50 (ms)"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p95 (ms)"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "requêtes"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "route"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, route) (immo_api_request_duration_milliseconds_bucket{route!~\"/health/.*\"}))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (immo_api_request_duration_milliseconds_bucket{route!~\"/health/.*\"}))",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (route) (immo_api_request_duration_milliseconds_count{route!~\"/health/.*\"}))",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Réponses 5xx, période affichée",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(immo_api_request_duration_milliseconds_count{status_class=\"5\"}[$__range])) or vector(0))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Contrôle de santé Caddy (1 = répond)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "caddy_reverse_proxy_upstreams_healthy{upstream=~\"api:8000|martin:3000\"}",
          "refId": "A",
          "legendFormat": "{{upstream}}",
          "instant": true,
          "range": false
        }
      ],
      "id": 5
    },
    {
      "type": "row",
      "title": "2. La carte est-elle lente ? Tuiles par couche et zoom",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": [],
      "id": 6
    },
    {
      "type": "table",
      "title": "Tuiles servies par Caddy, depuis le démarrage d'Alloy",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p95 (ms)"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "tuiles"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "zoom"
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1000 * histogram_quantile(0.95, sum by (le, layer, zoom) (immo_tile_request_duration_seconds_bucket))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (layer, zoom) (immo_tile_request_duration_seconds_count))",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "id": 7
    },
    {
      "type": "row",
      "title": "3. Les données sont-elles à jour ? Fraîcheur par source et territoire",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": [],
      "id": 8
    },
    {
      "type": "table",
      "title": "Âge en jours : publication du producteur, dernier import réussi",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "jours depuis la publication"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "jours depuis l'import"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "dataset"
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "floor((time() - immo_source_release_published_timestamp_seconds) / 86400)",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "floor((time() - (immo_source_last_import_success_timestamp_seconds > 0)) / 86400)",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "id": 9
    },
    {
      "type": "row",
      "title": "4. Un import a-t-il échoué ?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "panels": [],
      "id": 10
    },
    {
      "type": "table",
      "title": "Échecs non rattrapés (motif : meta.import_run.error_message)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 42
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "Value": true
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "immo_source_last_import_failure_timestamp_seconds > immo_source_last_import_success_timestamp_seconds",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "id": 11
    },
    {
      "type": "stat",
      "title": "Alertes actives",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 42
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "id": 12
    },
    {
      "type": "row",
      "title": "5. Que s'est-il passé pour cet utilisateur ? Journaux par référence",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "panels": [],
      "id": 13
    },
    {
      "type": "logs",
      "title": "Journaux API et Caddy contenant la référence",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{service=~\"api|caddy\"} |= \"$request_id\""
        }
      ],
      "id": 14
    }
  ]
}
