#!/usr/bin/env bash
set -euo pipefail

project_dir=${IMMO_PROJECT_DIR:-/opt/immo}
runtime_root=${RUNTIME_DATA_PATH:-/srv/immo/runtime}
mkdir -p "${runtime_root}/metrics"

compose=(
  docker compose --project-directory "${project_dir}" --env-file "${project_dir}/.env"
  -f "${project_dir}/compose.yaml" -f "${project_dir}/compose.prod.yaml"
  -f "${project_dir}/compose.observability.yaml"
)
query_output=$("${compose[@]}" exec -T postgres /bin/bash -ec '
  export PGPASSWORD="$(cat /run/secrets/postgres_superuser_password)"
  psql -U postgres -d immo -At -F "|" -c "
    SELECT '\''import'\'', COALESCE(extract(epoch FROM max(completed_at))::bigint, 0)::text
      FROM meta.import_run WHERE status = '\''succeeded'\''
    UNION ALL
    SELECT data_source_id, COALESCE(extract(epoch FROM max(published_at))::bigint, 0)::text
      FROM meta.active_dataset_release GROUP BY data_source_id ORDER BY 1;
  "
')

metric_tmp=$(mktemp "${runtime_root}/metrics/.pilot.XXXXXX")
{
  echo '# HELP immo_import_last_success_timestamp_seconds Last successful import.'
  echo '# TYPE immo_import_last_success_timestamp_seconds gauge'
  while IFS='|' read -r code timestamp; do
    if [[ ${code} == import ]]; then
      echo "immo_import_last_success_timestamp_seconds ${timestamp}"
    else
      echo "immo_source_last_publication_timestamp_seconds{dataset=\"${code}\"} ${timestamp}"
    fi
  done <<<"${query_output}"
} >"${metric_tmp}"
chmod 0644 "${metric_tmp}"
mv -- "${metric_tmp}" "${runtime_root}/metrics/pilot.prom"
