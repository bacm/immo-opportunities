#!/usr/bin/env bash
set -Eeuo pipefail

env_file="${COMPOSE_ENV_FILE:-.env.example}"

docker compose --env-file "$env_file" \
  -f compose.yaml -f compose.dev.yaml -f compose.observability.yaml \
  config --quiet

APP_DOMAIN=example.invalid \
WEB_IMAGE=example.invalid/immo-web:test \
API_IMAGE=example.invalid/immo-api:test \
PIPELINES_IMAGE=example.invalid/immo-pipelines:test \
docker compose --env-file "$env_file" \
  -f compose.yaml -f compose.prod.yaml -f compose.observability.yaml \
  config --quiet

# Le reglage PostgreSQL ne doit pas disparaitre en silence : l'image livre le
# postgresql.conf d'initdb, dont work_mem a 4 Mo faisait deborder sur disque les agregats
# des importeurs — 1 520 ms contre 475 ms mesurees le 7 septembre 2026. Voir
# docs/operations/postgresql-tuning.md.
missing=()
rendered="$(docker compose --env-file "$env_file" \
  -f compose.yaml -f compose.dev.yaml -f compose.observability.yaml \
  config)"
for setting in shared_buffers effective_cache_size work_mem maintenance_work_mem \
  random_page_cost effective_io_concurrency max_wal_size; do
  if ! grep -q -- "$setting=" <<<"$rendered"; then
    missing+=("$setting")
  fi
done
if ((${#missing[@]})); then
  echo "PostgreSQL tuning missing from the Compose configuration: ${missing[*]}" >&2
  exit 1
fi

# Démo (A6) : aucun port hors de 127.0.0.1, aucun service d'import démarré par défaut.
demo_rendered="$(SITE_ADDRESS=https://demo.example.invalid docker compose --env-file "$env_file" \
  -f compose.yaml -f compose.demo.yaml config --format json)"
public_ports="$(jq -r '.services[] | .ports[]? | select(.host_ip != "127.0.0.1") | .published' \
  <<<"$demo_rendered")"
if [[ -n $public_ports ]]; then
  echo "The demo Compose configuration publishes ports outside 127.0.0.1: ${public_ports}" >&2
  exit 1
fi
demo_ingestion="$(jq -r '.services | keys[] | select(test("^(dagster|minio|redis)"))' \
  <<<"$demo_rendered")"
if [[ -n $demo_ingestion ]]; then
  echo "The demo Compose configuration starts ingestion services: ${demo_ingestion}" >&2
  exit 1
fi

echo "Development, production and demo Compose configurations are valid."
echo "PostgreSQL tuning is declared for every measured setting."
