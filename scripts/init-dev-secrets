#!/usr/bin/env sh
set -eu

project_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
target_dir="${SECRETS_DIR:-$project_root/secrets/dev}"

umask 077
mkdir -p "$target_dir"

write_fixed_secret() {
  secret_name="$1"
  secret_value="$2"
  secret_path="$target_dir/$secret_name"

  if [ -e "$secret_path" ]; then
    return
  fi

  printf '%s\n' "$secret_value" > "$secret_path"
}

write_random_secret() {
  secret_name="$1"
  secret_path="$target_dir/$secret_name"

  if [ -e "$secret_path" ]; then
    return
  fi

  openssl rand -base64 36 | tr -d '\n' > "$secret_path"
  printf '\n' >> "$secret_path"
}

write_random_secret postgres_superuser_password
write_random_secret immo_db_password
write_random_secret keycloak_db_password
write_random_secret dagster_db_password
write_random_secret martin_db_password
write_random_secret redis_password
write_fixed_secret minio_root_user immo-dev-admin
write_random_secret minio_root_password
write_fixed_secret keycloak_admin_user immo-dev-admin
write_random_secret keycloak_admin_password
write_fixed_secret grafana_admin_user immo-dev-admin
write_random_secret grafana_admin_password

echo "Development secrets are ready in $target_dir; existing values were preserved."
