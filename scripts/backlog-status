#!/usr/bin/env python3
"""Régénère le tableau de suivi du backlog depuis les en-têtes des tickets.

L'état d'un ticket est saisi à un seul endroit : la ligne `**État :**` de son
fichier. La disponibilité (`Prêt` / `En attente`) est *dérivée* du graphe de
dépendances et n'est jamais saisie à la main.

Un ticket de nature humaine — revue contre les sources, arbitrage produit — n'est
jamais annoncé « prêt » mais « verrou humain » : la boucle de développement s'y
arrête. Ce verrou est une propriété déclarée du ticket, pas une appréciation portée
en cours de route ; un agent sous pression d'achèvement conclut toujours qu'il peut
se passer d'un humain.

Usage :
    scripts/backlog-status            régénère docs/backlog/README.md
    scripts/backlog-status --check    échoue si le README est périmé (CI)
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
BACKLOG = ROOT / "docs" / "backlog"
README = BACKLOG / "README.md"
SKIP = {"README.md", "NICE-backlog.md"}
STATES = {"À faire", "En cours", "Terminé", "Abandonné"}
NATURES = {"implémentation", "revue humaine", "décision humaine"}
HUMAN_NATURES = {"revue humaine", "décision humaine"}
BEGIN, END = "<!-- BEGIN:tickets -->", "<!-- END:tickets -->"
ID_RE = re.compile(r"\b(BUG-\d+|[A-G]\d[ab]?)\b")

SECTIONS = [
    ("A", "A — Clôture process", lambda i: i.startswith("A")),
    ("B", "B — v0.3 Référentiel spatial 35", lambda i: i.startswith("B") and not i.startswith("BUG")),
    ("BUG", "Bugs et dette technique", lambda i: i.startswith("BUG")),
    ("C", "C — v0.4 Carte réelle", lambda i: i.startswith("C")),
    ("D", "D — v0.5 Données métier 35", lambda i: i.startswith("D")),
    ("E", "E — v0.6 Scoring", lambda i: i.startswith("E")),
    ("F", "F — v0.7 Activation", lambda i: i.startswith("F")),
    ("G", "G — v0.8 Pilote Bretagne", lambda i: i.startswith("G")),
]


def ticket_id(name: str) -> str:
    parts = name.split("-")
    return f"{parts[0]}-{parts[1]}" if parts[0] == "BUG" else parts[0]


def header(text: str) -> str:
    """L'en-tête du ticket, borné à la première section.

    `Preuve :` réapparaît dans le corps de plusieurs tickets, en conclusion. Sans cette
    borne, le champ d'en-tête serait ambigu.
    """
    m = re.search(r"^## ", text, flags=re.M)
    return text[: m.start()] if m else text


def field(text: str, label: str) -> str | None:
    m = re.search(rf"\*\*{label} :\*\*\s*([^\n·]*)", header(text))
    return m.group(1).strip() if m else None


def strip_link(value: str) -> str:
    """Le chemin de preuve est écrit en lien Markdown dans les tickets."""
    m = re.search(r"\[`?([^`\]]+)`?\]\(([^)]+)\)", value)
    return (m.group(2) if m else value).strip().strip("`")


def proof_path(proof: str) -> Path:
    """Chemin de la preuve, écrit relatif au dépôt ou relatif au ticket."""
    return (BACKLOG / proof) if proof.startswith(".") else (ROOT / proof)


def load() -> dict:
    tickets = {}
    for path in sorted(BACKLOG.glob("*.md")):
        if path.name in SKIP:
            continue
        text = path.read_text(encoding="utf-8")
        tid = ticket_id(path.name)
        title = re.search(r"^# \S+ — (.+)$", text, flags=re.M)
        raw_deps = field(text, "Dépend de") or ""
        tickets[tid] = {
            "id": tid,
            "file": path.name,
            "title": title.group(1).strip() if title else path.stem,
            "version": field(text, "Version") or "—",
            "size": field(text, "Taille") or "—",
            "state": field(text, "État") or "",
            # Ce qui arrête la boucle. Voir `check_integrity` : un verrou humain ne se
            # clôt pas sans sa preuve sur disque.
            "nature": field(text, "Nature") or "implémentation",
            "proof": strip_link(field(text, "Preuve") or ""),
            "deps": list(dict.fromkeys(d for d in ID_RE.findall(raw_deps) if d != tid)),
            # Les chemins que le ticket va **ecrire**. Distinct de « Contexte a charger », qui
            # dit ce qu'il faut lire. Deux tickets sans dependance entre eux peuvent tres bien
            # ecrire dans le meme fichier : la disponibilite ne suffit donc pas a decider ce qui
            # peut etre mene de front.
            "writes": [
                path.strip()
                for path in (field(text, "Touche") or "").split(",")
                if path.strip() and path.strip() != "—"
            ],
        }
    return tickets


def duplicate_ids() -> list[str]:
    """Deux fichiers pour un identifiant : `load` n'en garde qu'un, dans l'ordre alphabetique.

    Le controle porte sur les fichiers presents, non sur le dictionnaire deja charge : au
    moment ou l'on tient ce dictionnaire, le ticket ecrase est precisement ce qui manque.
    Constate le 15 septembre 2026, deux sessions ayant ouvert chacune un ticket `A4` — le
    tableau annoncait 57 tickets pour 58 fichiers, sans rien signaler. Voir BUG-15.
    """
    by_id: dict[str, list[str]] = {}
    for path in sorted(BACKLOG.glob("*.md")):
        if path.name not in SKIP:
            by_id.setdefault(ticket_id(path.name), []).append(path.name)
    return [
        f"{tid} : {len(files)} fichiers portent cet identifiant — {', '.join(files)}"
        for tid, files in sorted(by_id.items())
        if len(files) > 1
    ]


def check_integrity(tickets: dict) -> list[str]:
    errors = duplicate_ids()
    for t in tickets.values():
        if t["state"] not in STATES:
            errors.append(f"{t['id']} : état « {t['state']} » hors nomenclature {sorted(STATES)}")
        if t["nature"] not in NATURES:
            errors.append(
                f"{t['id']} : nature « {t['nature']} » hors nomenclature {sorted(NATURES)}"
            )
        if t["nature"] in HUMAN_NATURES:
            if not t["proof"]:
                errors.append(
                    f"{t['id']} : verrou humain sans `**Preuve :**` déclarée — "
                    "le chemin du rapport ou de la décision attendue est obligatoire"
                )
            elif t["state"] == "Terminé" and not proof_path(t["proof"]).exists():
                errors.append(
                    f"{t['id']} : déclaré Terminé mais la preuve {t['proof']} n'existe pas — "
                    "un verrou humain ne se clôt pas sans le document qui porte le verdict"
                )
        for dep in t["deps"]:
            if dep not in tickets:
                errors.append(f"{t['id']} : dépendance inconnue {dep}")
    # cycles
    seen, stack = set(), set()

    def visit(tid, path):
        if tid in stack:
            errors.append(f"cycle de dépendances : {' → '.join(path + [tid])}")
            return
        if tid in seen or tid not in tickets:
            return
        stack.add(tid)
        for dep in tickets[tid]["deps"]:
            visit(dep, path + [tid])
        stack.discard(tid)
        seen.add(tid)

    for tid in tickets:
        visit(tid, [])
    return errors


def availability(t: dict, tickets: dict) -> str:
    if t["state"] in ("Terminé", "Abandonné"):
        return "—"
    if t["state"] == "En cours":
        return "en cours"
    blocking = [d for d in t["deps"] if tickets.get(d, {}).get("state") != "Terminé"]
    if blocking:
        return "attend " + ", ".join(blocking)
    return "**verrou humain**" if t["nature"] in HUMAN_NATURES else "**prêt**"


def collides(left: dict, right: dict) -> bool:
    """Deux tickets se disputent-ils un chemin ?

    Un chemin en prefixe d'un autre suffit : `pipelines/src/immo_pipelines/market_data/` et
    `pipelines/src/immo_pipelines/market_data/cnig.py` sont en conflit, le premier couvrant le
    second. Un ticket sans `Touche` declare est traite comme entrant en conflit avec tout le
    monde — l'inconnu ne se parallelise pas.
    """
    if not left["writes"] or not right["writes"]:
        return True
    return any(
        a == b or a.startswith(b.rstrip("/") + "/") or b.startswith(a.rstrip("/") + "/")
        for a in left["writes"]
        for b in right["writes"]
    )


def parallel_batches(tickets: dict) -> tuple[list[list[str]], list[str]]:
    """Les lots menables de front, et les tickets prêts qu'un travail en cours retient.

    Un ticket `En cours` **occupe ses chemins** : quelqu'un y écrit déjà. Un ticket prêt qui les
    touche n'est pas démarrable, quoi qu'en dise le graphe de dépendances — c'est précisément la
    collision que la colonne « Disponibilité » ne voyait pas.

    Le regroupement est glouton et non optimal, et c'est voulu : un ordonnancement exact
    n'apporterait rien, la contrainte réelle étant le nombre de personnes disponibles.
    """
    running = [t for t in tickets.values() if t["state"] == "En cours"]
    ready = [t for t in tickets.values() if availability(t, tickets) == "**prêt**"]
    ready.sort(key=lambda t: (not t["writes"], t["id"]))

    held = [t["id"] for t in ready if any(collides(t, r) for r in running)]
    free = [t for t in ready if t["id"] not in held]

    batches: list[list[dict]] = []
    for ticket in free:
        for batch in batches:
            if all(not collides(ticket, other) for other in batch):
                batch.append(ticket)
                break
        else:
            batches.append([ticket])
    return [[t["id"] for t in batch] for batch in batches], held


def render(tickets: dict) -> str:
    out = [BEGIN, ""]
    for _, heading, match in SECTIONS:
        rows = [t for tid, t in sorted(tickets.items()) if match(tid)]
        if not rows:
            continue
        out += [f"### {heading}", "", "| ID | Titre | Version | Dépend de | Taille | État | Disponibilité |",
                "|---|---|---|---|---|---|---|"]
        for t in rows:
            deps = ", ".join(t["deps"]) or "—"
            out.append(
                f"| [{t['id']}](./{t['file']}) | {t['title']} | {t['version']} | "
                f"{deps} | {t['size']} | {t['state']} | {availability(t, tickets)} |"
            )
        out.append("")
    ready = sorted(t["id"] for t in tickets.values() if availability(t, tickets) == "**prêt**")
    undeclared = sorted(
        t["id"]
        for t in tickets.values()
        if availability(t, tickets) == "**prêt**" and not t["writes"]
    )
    done = sum(1 for t in tickets.values() if t["state"] == "Terminé")
    out += [f"**{done}/{len(tickets)} terminés.** Prêts à démarrer : "
            + (", ".join(ready) if ready else "aucun") + ".", ""]
    locked = sorted(
        (t for t in tickets.values() if availability(t, tickets) == "**verrou humain**"),
        key=lambda t: t["id"],
    )
    if locked:
        out += ["### Verrous humains", "",
                "Ces tickets ne dépendent plus de rien et ne sont pourtant pas à prendre : leur "
                "verdict porte sur l'exactitude dans le monde réel ou sur un arbitrage produit. "
                "Une boucle de développement s'y arrête et rend la main.", ""]
        for t in locked:
            out.append(f"- **{t['id']}** — {t['nature']} · preuve attendue : `{t['proof']}`")
        out.append("")
    running = sorted(t["id"] for t in tickets.values() if t["state"] == "En cours")
    if running:
        out += ["### Déjà démarré", "",
                "Ces tickets occupent leurs chemins : ne pas y lancer un second travail. "
                "L'état vit dans la ligne `**État :**` de chaque fichier, source unique.", ""]
        for tid in running:
            paths = ", ".join(tickets[tid]["writes"]) or "chemins non déclarés"
            out.append(f"- **{tid}** — {paths}")
        out.append("")
    batches, held = parallel_batches(tickets)
    if held:
        out += ["Prêts mais **retenus par un travail en cours** : " + ", ".join(held) + ".", ""]
    if batches:
        out += ["### Lots menables de front", "",
                "Dérivé des chemins déclarés par `**Touche :**`. Deux tickets d'un même lot "
                "n'écrivent pas dans les mêmes fichiers ; un ticket sans `Touche` déclaré est "
                "supposé entrer en conflit avec tout le monde.", ""]
        for index, batch in enumerate(batches, start=1):
            out.append(f"{index}. " + ", ".join(batch))
        out.append("")
        if undeclared:
            out += ["Sans `Touche` déclaré, donc isolés par précaution : "
                    + ", ".join(undeclared) + ".", ""]
    out.append(END)
    return "\n".join(out)


def main() -> int:
    tickets = load()
    errors = check_integrity(tickets)
    if errors:
        print("Backlog incohérent :", file=sys.stderr)
        for e in errors:
            print(f"  - {e}", file=sys.stderr)
        return 1

    text = README.read_text(encoding="utf-8")
    if BEGIN not in text or END not in text:
        print(f"Marqueurs {BEGIN} / {END} absents de {README}", file=sys.stderr)
        return 1
    new = text[: text.index(BEGIN)] + render(tickets) + text[text.index(END) + len(END) :]

    if "--check" in sys.argv:
        if new != text:
            print("docs/backlog/README.md est périmé — lancer `make backlog`", file=sys.stderr)
            return 1
        print(f"Backlog à jour ({len(tickets)} tickets).")
        return 0

    README.write_text(new, encoding="utf-8")
    print(f"Backlog régénéré ({len(tickets)} tickets).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
